# Local development only. Copy to .env before starting Compose.
POSTGRES_USER=runveil
POSTGRES_PASSWORD=runveil-local-only
POSTGRES_DB=runveil
POSTGRES_PORT=5432

# Export this separately for the API and Alembic; neither auto-loads .env.
# Keep credentials/port consistent with PostgreSQL above. URL-encode special characters.
DATABASE_URL=postgresql+psycopg://runveil:runveil-local-only@127.0.0.1:5432/runveil
# Tests create/drop ONLY random runveil_test_* databases. Requires a CREATEDB role.
RUNVEIL_TEST_DATABASE_URL=postgresql+psycopg://runveil:runveil-local-only@127.0.0.1:5432/postgres
