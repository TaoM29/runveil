      "name": "controlled-code-reading",
      "version": "1",
      "split": "held-out",
      "scorer": "exact-summary-and-tools-v1",
      "cases": [
        {
          "id": "defaults-captured-value",
          "task": "Read example.py. After the module statements, what does cap() return? Return only the answer, without quotes or explanation.",
          "file_content": "LIMIT = 4\ndef cap(value=LIMIT):\n    return value\nLIMIT = 9\n",
          "responses": [
            "{\"action\":\"tool_call\",\"tool_name\":\"repository.read_file\",\"arguments\":{\"path\":\"example.py\"},\"decision_summary\":\"Read the allowlisted public source.\"}",
            "{\"action\":\"finish\",\"result\":{\"summary\":\"4\",\"artifacts\":[]}}"
          ],
          "expected_summary": "4",
          "expected_tools": ["repository.read_file"]
        },
        {
          "id": "branches-short-circuit",
          "task": "Search example.py for `def usable`, then read the file. What does usable([]) return? Return only the answer, without quotes or explanation.",
          "file_content": "def usable(items):\n    return bool(items) and items[0] > 0\n",
          "responses": [
            "{\"action\":\"tool_call\",\"tool_name\":\"repository.search\",\"arguments\":{\"query\":\"def usable\"},\"decision_summary\":\"Locate the requested public source definition.\"}",
            "{\"action\":\"tool_call\",\"tool_name\":\"repository.read_file\",\"arguments\":{\"path\":\"example.py\"},\"decision_summary\":\"Read the allowlisted public source.\"}",
            "{\"action\":\"finish\",\"result\":{\"summary\":\"False\",\"artifacts\":[]}}"
          ],
          "expected_summary": "False",
          "expected_tools": ["repository.search", "repository.read_file"]
        },
        {
          "id": "collections-alias",
          "task": "Read example.py. What does head() return? Return only the answer, without quotes or explanation.",
          "file_content": "def head():\n    values = [2, 4]\n    alias = values\n    alias[0] = 7\n    return values[0]\n",
          "responses": [
            "{\"action\":\"tool_call\",\"tool_name\":\"repository.read_file\",\"arguments\":{\"path\":\"example.py\"},\"decision_summary\":\"Read the allowlisted public source.\"}",
            "{\"action\":\"finish\",\"result\":{\"summary\":\"7\",\"artifacts\":[]}}"
          ],
          "expected_summary": "7",
          "expected_tools": ["repository.read_file"]
        },
        {
          "id": "strings-suffix",
          "task": "Search example.py for `def stem`, then read the file. What does stem('copy.py.py') return? Return only the answer, without quotes or explanation.",
          "file_content": "def stem(name):\n    return name.removesuffix('.py')\n",
          "responses": [
            "{\"action\":\"tool_call\",\"tool_name\":\"repository.search\",\"arguments\":{\"query\":\"def stem\"},\"decision_summary\":\"Locate the requested public source definition.\"}",
            "{\"action\":\"tool_call\",\"tool_name\":\"repository.read_file\",\"arguments\":{\"path\":\"example.py\"},\"decision_summary\":\"Read the allowlisted public source.\"}",
            "{\"action\":\"finish\",\"result\":{\"summary\":\"copy.py\",\"artifacts\":[]}}"
          ],
          "expected_summary": "copy.py",
          "expected_tools": ["repository.search", "repository.read_file"]
        },
        {
          "id": "iteration-zip-bound",
          "task": "Read example.py. What does pairs() return? Return only the answer, without quotes or explanation.",
          "file_content": "def pairs():\n    return len(list(zip([1, 2, 3], ['a', 'b'])))\n",
          "responses": [
            "{\"action\":\"tool_call\",\"tool_name\":\"repository.read_file\",\"arguments\":{\"path\":\"example.py\"},\"decision_summary\":\"Read the allowlisted public source.\"}",
            "{\"action\":\"finish\",\"result\":{\"summary\":\"2\",\"artifacts\":[]}}"
          ],
          "expected_summary": "2",
          "expected_tools": ["repository.read_file"]
        },
        {
          "id": "exceptions-else",
          "task": "Search example.py for `def parse`, then read the file. What does parse('12') return? Return only the answer, without quotes or explanation.",
          "file_content": "def parse(value):\n    try:\n        int(value)\n    except ValueError:\n        return 'bad'\n    else:\n        return 'ok'\n",
          "responses": [
            "{\"action\":\"tool_call\",\"tool_name\":\"repository.search\",\"arguments\":{\"query\":\"def parse\"},\"decision_summary\":\"Locate the requested public source definition.\"}",
            "{\"action\":\"tool_call\",\"tool_name\":\"repository.read_file\",\"arguments\":{\"path\":\"example.py\"},\"decision_summary\":\"Read the allowlisted public source.\"}",
            "{\"action\":\"finish\",\"result\":{\"summary\":\"ok\",\"artifacts\":[]}}"
          ],
          "expected_summary": "ok",
          "expected_tools": ["repository.search", "repository.read_file"]
        },
        {
          "id": "scope-nonlocal",
          "task": "Read example.py. What does counter() return? Return only the answer, without quotes or explanation.",
          "file_content": "def counter():\n    value = 1\n    def bump():\n        nonlocal value\n        value += 2\n    bump()\n    return value\n",
          "responses": [
            "{\"action\":\"tool_call\",\"tool_name\":\"repository.read_file\",\"arguments\":{\"path\":\"example.py\"},\"decision_summary\":\"Read the allowlisted public source.\"}",
            "{\"action\":\"finish\",\"result\":{\"summary\":\"3\",\"artifacts\":[]}}"
          ],
          "expected_summary": "3",
          "expected_tools": ["repository.read_file"]
        },
        {
          "id": "inspection-handler-type",
          "task": "Search example.py for `def lookup`, then read the file. Which exception class is explicitly caught? Return only the answer, without quotes or explanation.",
          "file_content": "def lookup(mapping, key):\n    try:\n        return mapping[key]\n    except KeyError:\n        return None\n",
          "responses": [
            "{\"action\":\"tool_call\",\"tool_name\":\"repository.search\",\"arguments\":{\"query\":\"def lookup\"},\"decision_summary\":\"Locate the requested public source definition.\"}",
            "{\"action\":\"tool_call\",\"tool_name\":\"repository.read_file\",\"arguments\":{\"path\":\"example.py\"},\"decision_summary\":\"Read the allowlisted public source.\"}",
            "{\"action\":\"finish\",\"result\":{\"summary\":\"KeyError\",\"artifacts\":[]}}"
          ],
          "expected_summary": "KeyError",
          "expected_tools": ["repository.search", "repository.read_file"]
        }
      ]
    },
